# AIOps System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# === Jenkins Configuration ===
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=your_jenkins_api_token_here

# === Prometheus Configuration ===
PROMETHEUS_URL=http://localhost:9090

# === Kubernetes Configuration ===
K8S_IN_CLUSTER=false
# KUBECONFIG=C:\Users\YourUser\.kube\config
K8S_NAMESPACE=default

# === Orchestrator Configuration ===
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000

# === Autoscaler Configuration ===
AUTOSCALER_CPU_HIGH=0.7
AUTOSCALER_CPU_LOW=0.3
AUTOSCALER_ANOMALY_THRESHOLD=0.5
AUTOSCALER_FAILURE_THRESHOLD=0.6
AUTOSCALER_MIN_REPLICAS=1
AUTOSCALER_MAX_REPLICAS=10
AUTOSCALER_SCALE_UP_INCREMENT=2
AUTOSCALER_SCALE_DOWN_DECREMENT=1
AUTOSCALER_COOLDOWN_SECONDS=300
